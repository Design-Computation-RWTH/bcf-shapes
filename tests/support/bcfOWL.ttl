@prefix : <https://w3id.org/bcfOWL#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bcfOWL#> .

<https://w3id.org/bcfOWL#> rdf:type owl:Ontology ;
                            owl:versionIRI <https://w3id.org/bcfOWL/1.0.0> ;
                            <http://purl.org/dc/terms/abstract> "bcfOWL represents the BIM Collaboration Format (BCF) in RDF. It does not translate the BCF schema one to one. It composes BCF from established vocabularies (SOSA, SPOT, PROV-O, DCAT, SKOS, Dublin Core) and keeps only the coordination concepts that no other vocabulary covers, such as Topic, Comment, Viewpoint, and the visual state."@en ;
                            <http://purl.org/dc/terms/bibliographicCitation> "Schulz, O., Oraskari, J., & Beetz, J. (2026). bcfOWL: BIM Collaboration Format Ontology (Version 1.0.0) [Ontology]. Design Computation, RWTH Aachen University. https://w3id.org/bcfOWL"@en ;
                            <http://purl.org/dc/terms/creator> _:genid1 ,
                                                               _:genid3 ,
                                                               _:genid4 ;
                            <http://purl.org/dc/terms/description> "bcfOWL covers the BCF concepts Project, Topic, Comment and Viewpoint, the project-specific extension values, and the visual state of a Viewpoint. Generic concerns are delegated to established vocabularies: identity and creation to Dublin Core Terms, cameras and observations to SOSA, poses to SPOT, images to DCAT, agents and change history to PROV-O, and extension values to SKOS. The structural rules of BCF are not OWL axioms. They are in the separate SHACL profile bcfOWL-shapes. The changes since the last published version, 0.7.1, are listed in CHANGELOG.md."@en ;
                            <http://purl.org/dc/terms/issued> "2026-10-07"^^xsd:date ;
                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                            <http://purl.org/dc/terms/modified> "2026-10-07"^^xsd:date ;
                            <http://purl.org/dc/terms/publisher> _:genid5 ;
                            <http://purl.org/dc/terms/title> "BIM Collaboration Format Ontology"@en ;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "bcfOWL" ;
                            <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/bcfOWL#> ;
                            rdfs:label "bcfOWL"@en ;
                            rdfs:seeAlso <https://lbd.arch.rwth-aachen.de/bcfOWL_V1/index-en.html> ;
                            owl:incompatibleWith <http://lbd.arch.rwth-aachen.de/bcfOWL#> ;
                            owl:priorVersion <http://lbd.arch.rwth-aachen.de/bcfOWL#> ;
                            owl:versionInfo "1.0.0" .

_:genid1 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid2 ;
          <http://schema.org/name> "Oliver Schulz" ;
          <http://schema.org/url> "https://github.com/OlliSchu" .

_:genid3 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid2 ;
          <http://schema.org/name> "Jyrki Oraskari" ;
          <http://schema.org/url> "https://github.com/jyrkioraskari" .

_:genid4 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid2 ;
          <http://schema.org/name> "Jakob Beetz" ;
          <http://schema.org/url> "https://github.com/jakob-beetz" .

_:genid5 rdf:type <http://schema.org/Person> ;
          <http://schema.org/name> "Jyrki Oraskari" .

_:genid2 rdf:type <http://schema.org/Organization> ;
          <http://schema.org/name> "Design Computation, RWTH Aachen University" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/" .

#################################################################
