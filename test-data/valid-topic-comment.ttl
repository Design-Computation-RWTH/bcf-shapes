# A clash Topic with a Comment.
# A ventilation duct (MEP model) crosses a steel beam (structural model) on level 2.
# The Topic carries the current values. The Comment refers to a Viewpoint.

@prefix bcfOWL:  <https://w3id.org/bcfOWL#> .
@prefix bot:     <https://w3id.org/bot#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <http://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix spot:    <https://w3id.org/spot#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/bcfowl-example#> .

ex:topic1 a bcfOWL:Topic;
  bcfOWL:hasProject ex:project;
  dcterms:identifier "5a52cbe2-edd7-41d8-b610-fab29397cc74";
  dcterms:title "Duct D-204 clashes with beam B-117 on level 2";
  dcterms:description "The supply air duct passes through the flange of the steel beam. Clearance is negative by about 80 mm.";
  dcterms:creator ex:clash_detector;
  dcterms:created "2026-03-12T09:05:00Z"^^xsd:dateTime;
  bcfOWL:hasTopicType ex:type_clash;
  bcfOWL:hasTopicStatus ex:status_open;
  bcfOWL:hasPriority ex:priority_high;
  bcfOWL:hasStage ex:stage_detailed_design;
  bcfOWL:hasLabels ex:label_mep, ex:label_structure;
  bcfOWL:hasAssignedTo ex:mep_engineer;
  bcfOWL:hasDueDate "2026-03-27T00:00:00Z"^^xsd:dateTime;
  # The BCF reference_links field. More precise relations may be added next to it.
  bcfOWL:hasReferenceLink ex:duct_d204, ex:beam_b117;
  schema:about ex:duct_d204, ex:beam_b117.

ex:duct_d204 a bot:Element;
  dcterms:title "Supply air duct D-204".

ex:beam_b117 a bot:Element;
  dcterms:title "Steel beam B-117".

ex:comment1 a bcfOWL:Comment;
  bcfOWL:hasProject ex:project;
  bcfOWL:hasTopic ex:topic1;
  bcfOWL:hasViewpoint ex:viewpoint1;
  dcterms:identifier "1a37f501-a647-4092-afd7-c410bc84ae1d";
  dcterms:creator ex:structural_engineer;
  dcterms:created "2026-03-12T10:20:00Z"^^xsd:dateTime;
  bcfOWL:hasCommentText "The beam size is fixed by the load calculation. Please reroute the duct below the beam.".

#################################################################
# CONTEXT: the resources that the data above refers to.
#################################################################

# The project, its users and its extension schema.
ex:project a bcfOWL:Project;
  dcterms:identifier "b25906e0-2ca8-4fcd-97d9-8b4a4a2b9a3f";
  dcterms:title "Office building, design coordination";
  bcfOWL:hasExtensionSchema ex:extension_schema;
  # The space in which BCF API coordinates of this project are exposed and accepted.
  bcfOWL:referenceSpace ex:building_space.

# The coordinate system of the federated model.
ex:building_space a spot:AssetSpace.

# The federated model that the issues refer to.
ex:federated_model a dcat:Dataset;
  dcterms:title "Office building, federated IFC model";
  dcat:distribution [
    a dcat:Distribution;
    dcat:downloadURL <https://example.org/models/office-federated.ifc>;
    dcat:mediaType "application/x-step"
  ].

# USERS (project participants)
ex:structural_engineer a prov:Person, prov:Agent;
  dcterms:identifier "structure@example.org".

ex:mep_engineer a prov:Person, prov:Agent;
  dcterms:identifier "mep@example.org".

# Software can also be an agent, for example an automatic clash detection run.
ex:clash_detector a prov:SoftwareAgent, prov:Agent;
  dcterms:identifier "clash-detector@example.org".

# EXTENSION SCHEMA
ex:extension_schema a bcfOWL:ExtensionSchema;
  bcfOWL:hasUser ex:structural_engineer, ex:mep_engineer, ex:clash_detector;
  bcfOWL:hasTypeScheme ex:type_scheme;
  bcfOWL:hasStatusScheme ex:status_scheme;
  bcfOWL:hasLabelScheme ex:label_scheme;
  bcfOWL:hasPriorityScheme ex:priority_scheme;
  bcfOWL:hasStageScheme ex:stage_scheme.

ex:type_scheme a skos:ConceptScheme; skos:prefLabel "Issue types"@en.
ex:type_clash a bcfOWL:TopicType;
  skos:inScheme ex:type_scheme; skos:prefLabel "Clash"@en.
ex:type_rfi a bcfOWL:TopicType;
  skos:inScheme ex:type_scheme; skos:prefLabel "Request for information"@en.

ex:status_scheme a skos:ConceptScheme; skos:prefLabel "Issue statuses"@en.
ex:status_open a bcfOWL:TopicStatus;
  skos:inScheme ex:status_scheme; skos:prefLabel "Open"@en.
ex:status_in_progress a bcfOWL:TopicStatus;
  skos:inScheme ex:status_scheme; skos:prefLabel "In progress"@en.
ex:status_resolved a bcfOWL:TopicStatus;
  skos:inScheme ex:status_scheme; skos:prefLabel "Resolved"@en.

ex:label_scheme a skos:ConceptScheme; skos:prefLabel "Disciplines"@en.
ex:label_structure a bcfOWL:Label;
  skos:inScheme ex:label_scheme; skos:prefLabel "Structure"@en.
ex:label_mep a bcfOWL:Label;
  skos:inScheme ex:label_scheme; skos:prefLabel "MEP"@en.

ex:priority_scheme a skos:ConceptScheme; skos:prefLabel "Priorities"@en.
ex:priority_high a bcfOWL:Priority;
  skos:inScheme ex:priority_scheme; skos:prefLabel "High"@en.

ex:stage_scheme a skos:ConceptScheme; skos:prefLabel "Design stages"@en.
ex:stage_detailed_design a bcfOWL:Stage;
  skos:inScheme ex:stage_scheme; skos:prefLabel "Detailed design"@en.

# The Viewpoint that comment1 refers to.
ex:viewpoint1 a bcfOWL:Viewpoint;
  bcfOWL:hasProject ex:project;
  bcfOWL:hasTopic ex:topic1;
  dcterms:identifier "8c61fb85-b73e-4182-988f-d7e5988d348d";
  bcfOWL:hasPerspectiveCamera ex:view1.

ex:view1 a sosa:Observation;
  bcfOWL:hasFieldOfView "60.0"^^xsd:double;
  bcfOWL:hasAspectRatio "1.7777777778"^^xsd:double.
