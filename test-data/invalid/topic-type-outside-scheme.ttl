@prefix bcfOWL:  <https://w3id.org/bcfOWL#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix spot:    <https://w3id.org/spot#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/fixture#> .

# The type is a valid bcfOWL:TopicType, but it belongs to a scheme that this
# project does not declare. Only the SHACL-SPARQL shape catches this fault.
ex:type-foreign a bcfOWL:TopicType ;
    skos:inScheme ex:foreign-scheme ;
    skos:prefLabel "Foreign"@en .

ex:topic-foreign-type a bcfOWL:Topic ;
    dcterms:identifier "foreign-type" ;
    dcterms:title "Foreign type" ;
    dcterms:creator ex:anna ;
    dcterms:created "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    bcfOWL:hasProject ex:project ;
    bcfOWL:hasTopicType ex:type-foreign .
