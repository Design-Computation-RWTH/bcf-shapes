@prefix bcfOWL:  <https://w3id.org/bcfOWL#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix spot:    <https://w3id.org/spot#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/fixture#> .

# The creator must be a prov:Agent. This creator is a SPOT space.
# The same fault also breaks the users rule, because a project user is
# always a prov:Agent.
ex:topic-creator-not-agent a bcfOWL:Topic ;
    dcterms:identifier "creator-not-agent" ;
    dcterms:title "Creator not an agent" ;
    dcterms:creator ex:assetspace ;
    dcterms:created "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    bcfOWL:hasProject ex:project .
