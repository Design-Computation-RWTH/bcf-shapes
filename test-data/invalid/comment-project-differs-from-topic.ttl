@prefix bcfOWL:  <https://w3id.org/bcfOWL#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix spot:    <https://w3id.org/spot#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/fixture#> .

# A Comment is in the project of its Topic. This Comment refers to a different
# project. The second project is valid, so the only fault is the mismatch.
ex:other-project a bcfOWL:Project ;
    dcterms:identifier "other-project" ;
    dcterms:title "Other project"@en ;
    bcfOWL:referenceSpace ex:assetspace ;
    bcfOWL:hasExtensionSchema ex:extensions .

ex:topic-host a bcfOWL:Topic ;
    dcterms:identifier "host" ;
    dcterms:title "Comment host" ;
    dcterms:creator ex:anna ;
    dcterms:created "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    bcfOWL:hasProject ex:project .

ex:comment-other-project a bcfOWL:Comment ;
    dcterms:identifier "other-project-comment" ;
    bcfOWL:hasCommentText "A comment in the wrong project." ;
    dcterms:creator ex:anna ;
    dcterms:created "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    bcfOWL:hasTopic ex:topic-host ;
    bcfOWL:hasProject ex:other-project .
