@prefix bcfOWL:  <https://w3id.org/bcfOWL#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix spot:    <https://w3id.org/spot#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/fixture#> .

# dcterms:modified is the BCF modified_date. A Topic has at most one
# current modification date.
ex:topic-two-modified a bcfOWL:Topic ;
    dcterms:identifier "two-modified" ;
    dcterms:title "Two modification dates" ;
    dcterms:creator ex:anna ;
    dcterms:created "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    bcfOWL:hasProject ex:project ;
    dcterms:modified "2026-01-02T00:00:00Z"^^xsd:dateTime ,
        "2026-01-03T00:00:00Z"^^xsd:dateTime .
